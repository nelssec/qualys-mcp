# ── Qualys credentials (required) ───────────────────────────────────────
# A read-only Qualys API user is strongly recommended.
# NOTE: docker compose expands $ in these values. If your password contains
# a $, write it as $$ (e.g. pa$$word for pa$word).
QUALYS_USERNAME=your-qualys-username
QUALYS_PASSWORD=your-qualys-password

# ── Qualys platform (required — pick ONE style) ─────────────────────────
# Option A: platform POD code (US1, US2, US3, US4, EU1, EU2, IN1, ...)
QUALYS_POD=US2
# Option B: explicit URLs (uncomment both, remove QUALYS_POD)
# QUALYS_BASE_URL=https://qualysapi.qg2.apps.qualys.com
# QUALYS_GATEWAY_URL=https://gateway.qg2.apps.qualys.com

# ── MCP endpoint auth (optional, recommended if not loopback-only) ──────
# When set, every HTTP request must send: Authorization: Bearer <token>
# Generate one with: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# ── Advanced (optional) ─────────────────────────────────────────────────
# Server listen port; docker compose picks it up automatically for the
# port mapping in compose.yaml.
# MCP_PORT=8000
# Cache TTL overrides, seconds:
# CACHE_TTL_VMDR=14400
# CACHE_TTL_CSAM=21600
